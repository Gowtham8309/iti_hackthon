# ITI Attendance AI — Production Environment
# Copy to .env on the NIC server and fill in all placeholder values.
# Never commit this file with real secrets to version control.

# ─── Application ───────────────────────────────────────────────────────────────
APP_NAME=AI-Powered ITI In-Plant Training Attendance System
APP_ENV=production
APP_VERSION=1.0.0
HOST=127.0.0.1
PORT=8000

# ─── Database (Neon serverless PostgreSQL) ─────────────────────────────────────
DATABASE_URL="postgresql://neondb_owner:npg_8KekXYw0ZPUT@ep-super-king-aputoe1t.c-7.us-east-1.aws.neon.tech/neondb?sslmode=require"
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=300
DB_CONNECT_TIMEOUT_SECONDS=10

# ─── JWT Authentication ─────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(48))"
JWT_SECRET_KEY=REPLACE_WITH_STRONG_RANDOM_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ─── Password Reset Tokens ──────────────────────────────────────────────────────
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

# ─── CORS (restrict to actual deployment domain) ────────────────────────────────
CORS_ORIGINS=https://attendance.iti.ap.gov.in

# ─── GPS / Geofence ─────────────────────────────────────────────────────────────
DEFAULT_GEOFENCE_RADIUS_METERS=100
MAX_ALLOWED_GPS_ACCURACY_METERS=50

# ─── Face Recognition ───────────────────────────────────────────────────────────
FACE_MATCH_ACCEPT_THRESHOLD=0.75
FACE_MATCH_REVIEW_THRESHOLD=0.60
MAX_FACE_IMAGE_SIZE_MB=5
UPLOAD_DIR=storage/uploads

# ─── Server-side Liveness Detection ────────────────────────────────────────────
LIVENESS_LAPLACIAN_THRESHOLD=80.0
LIVENESS_TEXTURE_THRESHOLD=0.15

# ─── ML Anomaly Detection ───────────────────────────────────────────────────────
ML_ANOMALY_MODEL_PATH=storage/ml/isolation_forest.joblib
ML_ANOMALY_RETRAIN_AFTER_EVENTS=100

# ─── Rate Limiting ──────────────────────────────────────────────────────────────
RATE_LIMIT_LOGIN=10/minute
RATE_LIMIT_SIGNUP=5/minute

# ─── Email Notifications (SMTP) ─────────────────────────────────────────────────
EMAIL_NOTIFICATIONS_ENABLED=false
DEFAULT_NOTIFICATION_EMAILS=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=REPLACE_WITH_SMTP_EMAIL
SMTP_PASSWORD=REPLACE_WITH_SMTP_APP_PASSWORD
SMTP_FROM_EMAIL=REPLACE_WITH_SMTP_EMAIL
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# ─── SMS Notifications (Fast2SMS) ───────────────────────────────────────────────
SMS_NOTIFICATIONS_ENABLED=false
SMS_PROVIDER=fast2sms
FAST2SMS_API_KEY=REPLACE_WITH_FAST2SMS_KEY
SMS_SENDER_ID=ITITND
DEFAULT_NOTIFICATION_MOBILES=

# ─── ITI Portal Integration ─────────────────────────────────────────────────────
ITI_PORTAL_BASE_URL=https://iti.ap.gov.in
ITI_PORTAL_API_KEY=REPLACE_WITH_ITI_PORTAL_API_KEY
ITI_PORTAL_SYNC_ENABLED=false

# ─── District Dashboard Integration ─────────────────────────────────────────────
DISTRICT_DASHBOARD_WEBHOOK_URL=REPLACE_WITH_WEBHOOK_URL
DISTRICT_DASHBOARD_SYNC_ENABLED=false
INDUSTRY_HR_SYNC_ENABLED=false

# ─── Data Retention / Privacy ───────────────────────────────────────────────────
ENCRYPT_BIOMETRICS_AT_REST=true
SELFIE_RETENTION_POLICY=keep_until_manual_delete
ATTENDANCE_LOG_RETENTION_POLICY=keep_permanently
